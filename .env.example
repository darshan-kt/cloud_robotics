# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# docker-compose.yml already provides sane defaults for every one of these
# (via ${VAR:-default} substitution), so `docker compose up` works with zero
# setup. This file exists so you never have to hunt through docker-compose.yml
# to find what's configurable - see docs/02-docker-foundations.md.

# --- Robot ---
ROBOT_ID=turtlebot3_01
# Local HTTP health/metrics endpoint (robot_agent/health_server.py) - for
# the container orchestrator, separate from the MQTT `health` topic which
# reports to the fleet backend. See docs/04-robot-agent.md.
ROBOT_HEALTH_PORT=8080
# Bearer token guarding /metrics and /status. Empty = open, which is fine
# locally because docker-compose.yml publishes this port to 127.0.0.1 only.
# SET THIS on real robot hardware: /metrics reveals robot_id, which is also
# the robot's MQTT username. Generate with `openssl rand -hex 32`.
# See docs/security-findings.md F1.
ROBOT_HEALTH_TOKEN=

# --- Camera (webcam_driver.py, Milestone 6 respun) ---
# A real, locally-attached webcam feeds /camera/image_raw - Gazebo's
# simulated camera sensor is no longer used (Gazebo still drives physics/
# cmd_vel/odom). The device is only actually passed into the container if
# you also apply docker-compose.camera.yml - see that file and
# docs/06-video-streaming.md.
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
# OFF by default on purpose: a real deployment with no camera should fail
# loudly (repeated warnings, zero video frames), not silently substitute
# fake video. Set to true only on dev/CI machines with no webcam hardware
# at all, to still exercise the rest of the video pipeline.
CAMERA_TEST_PATTERN_FALLBACK=false

# --- MQTT (Eclipse Mosquitto) ---
MQTT_HOST=mosquitto
# The port CLIENTS (backend, robot) connect to: 1883 plaintext, 8883 TLS.
# Set this to 8883 together with MQTT_TLS_ENABLED=true below.
MQTT_PORT=1883
# Where the broker's ports appear on the HOST, for local debugging only
# (mosquitto_pub/sub by hand). Deliberately separate from MQTT_PORT - they
# answer different questions, and tying them together meant enabling TLS
# silently remapped the plaintext port and collided with the TLS one.
MQTT_HOST_PORT=1883
MQTT_TLS_HOST_PORT=8883
# Broker credentials - regenerated from these on every container start
# (see cloud-container/mosquitto/docker-entrypoint-wrapper.sh), never
# committed as a hashed file. The robot always authenticates as
# username=ROBOT_ID, so it has no separate username variable.
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=backend_dev_password
MQTT_ROBOT_PASSWORD=robot_dev_password
# --- Per-robot credentials (docs/security-findings.md F7) ---
# A robot's MQTT username IS its robot_id, and robot_ids are public (they
# appear in topics, REST URLs, and the dashboard). One shared password
# across a fleet therefore means any robot can authenticate as any other:
# forge its telemetry, intercept its commands. Give each robot its own.
# Comma-separated robot_id:password pairs; leave empty for single-robot
# local dev, which falls back to ROBOT_ID/MQTT_ROBOT_PASSWORD above.
#   MQTT_ROBOT_CREDENTIALS=turtlebot3_01:pw1,turtlebot3_02:pw2
MQTT_ROBOT_CREDENTIALS=turtlebot3_01:robot_dev_password,turtlebot3_02:robot_dev_password_02,turtlebot3_03:robot_dev_password_03

# --- MQTT over TLS (docs/security-findings.md F6) ---
# Off by default - the stack talks over an internal Docker network. Turn on
# for anything crossing a real network. Generate dev certificates first:
#   ./scripts/generate-dev-certs.sh
# then set MQTT_TLS_ENABLED=true and MQTT_PORT=8883.
MQTT_TLS_ENABLED=false
MQTT_TLS_PORT=8883
# Path INSIDE the containers (both mount ./certs). Clients verify the
# broker against this CA.
MQTT_TLS_CA_CERTS=/mosquitto/certs/ca.crt
# Client certificate for mutual TLS. Unused today (auth is still
# username/password over the TLS channel) - these are the knobs the
# per-device certificate work needs, see docs/target-architecture.md D3.
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
# Skips broker hostname verification. Local bring-up only - it removes the
# guarantee that you are talking to the broker you think you are.
MQTT_TLS_INSECURE=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Redis previously had no password at all and its port was published to the
# host - anyone who could reach it could read/write session locks and fleet
# state directly, completely bypassing the JWT/session layer. Now required.
# CHANGE THIS before any real deployment - see docs/12-security-hardening.md.
REDIS_PASSWORD=redis_dev_password_change_me

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloud_robotics
POSTGRES_USER=robotics
POSTGRES_PASSWORD=robotics_dev_password

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
LOG_LEVEL=INFO
# "development" (default) preserves today's zero-config `docker compose up`
# experience. Set to "production" to turn on a hard startup guard that
# refuses to boot if any credential below still equals its known dev
# default - see app/config.py's assert_production_safe() and
# docs/12-security-hardening.md.
ENVIRONMENT=development
# Comma-separated list of origins allowed to call this API from a browser.
# Was "*" - locked down since bearer tokens are readable by any origin that
# can get a request through. Add every real frontend origin here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# --- auth/ + sessions/ (Milestone 7) ---
# One shared operator credential from env - same "no separate provisioning
# system yet" shape as the MQTT credentials above. See docs/07-cloud-backend.md.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator_dev_password
# CHANGE THIS before any real deployment - the default is intentionally
# obvious so nobody mistakes it for something safe to ship.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
# Lowered from 3600 -> 1800: a stolen token is now live for at most 30
# minutes, and can also be revoked immediately via POST /auth/logout - see
# docs/12-security-hardening.md.
JWT_EXPIRY_SECONDS=1800
# How long an operator's exclusive robot-control session survives with no
# renewal (a teleop command or WS activity) before another operator can
# take over - the session-layer equivalent of the robot's own MQTT
# Last-Will-and-Testament. See docs/07-cloud-backend.md.
SESSION_TTL_SECONDS=30

# --- Frontend (React) ---
FRONTEND_PORT=3000
# Must be reachable from the BROWSER, not just other containers - so this
# stays a host-published address (localhost), never the internal Docker
# service name "backend". See docs/02-docker-foundations.md.
API_BASE_URL=http://localhost:8000

# --- TURN (coturn, Milestone 9) ---
# One shared dev credential, same "no separate provisioning system yet"
# shape as the MQTT/operator credentials above. Needed for real WebRTC
# connectivity, not just as a NAT-traversal nicety - see docs/09-frontend.md
# for why STUN alone isn't enough against a real Chrome browser here.
TURN_USERNAME=turnuser
TURN_PASSWORD=turn_dev_password
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Must be reachable from the BROWSER - same reasoning as API_BASE_URL above.
TURN_HOST=localhost

# --- ROBOSTORE (robostore-poc/, demo app-store console, POC) ---
# Only read by docker-compose.robostore.yml - the main stack above never
# touches these. See robostore-poc/README.md.
ROBOSTORE_PORT=3100
ROBOSTORE_PROD_PORT=3101
# Unused until an app in robostore-poc actually needs live robot data - see
# robostore-poc/src/lib/config.ts. Must be a BROWSER-reachable address, same
# reasoning as API_BASE_URL above.
VITE_GATEWAY_URL=http://localhost:1717

# --- Extra fleet members (docker-compose.fleet.yml / `make up-fleet`) -------
# Each robot MUST have its own broker credential: the MQTT username IS the
# robot_id, and robot_ids are public (they appear in topics, REST URLs and the
# dashboard), so a shared password means knowing an id is enough to
# authenticate as that robot. See docs/security-findings.md F7.
#
# This list is what provisions the broker's password file. Every robot that
# connects must appear here, INCLUDING turtlebot3_01 — once this is set it
# replaces the single ROBOT_ID/MQTT_ROBOT_PASSWORD pair entirely.

ROBOT_02_ID=turtlebot3_02
ROBOT_02_MQTT_PASSWORD=robot_dev_password_02
ROBOT_02_HEALTH_PORT=8180

ROBOT_03_ID=turtlebot3_03
ROBOT_03_MQTT_PASSWORD=robot_dev_password_03
ROBOT_03_HEALTH_PORT=8181
