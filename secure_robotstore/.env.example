# Copy to .env and adjust if a port is already taken.
#
# Ports sit one above the main cloud-robotics stack so both can run at the
# same time (main uses 1883/6379/5432/8000/3000/8080).

MQTT_HOST_PORT=1884
REDIS_HOST_PORT=6380
POSTGRES_HOST_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=3001
AGENT_HEALTH_PORT=8081

# INTERN TASK (security): these are committed defaults in an example file
# and reused verbatim by docker-compose.yml. Real deployments generate
# per-environment secrets — see scripts/generate-secrets.sh in the main repo.
POSTGRES_DB=robotstore
POSTGRES_USER=robotstore
POSTGRES_PASSWORD=robotstore

DEVICE_ID=demo-device-01
PUBLISH_INTERVAL_SECONDS=1.0
LOG_LEVEL=INFO
