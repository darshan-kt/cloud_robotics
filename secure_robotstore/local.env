# Settings for running secure_robotstore directly on your machine, with no
# Docker. Load it into a terminal with:   source local.env
#
# These point the backend and the agent at services running on localhost
# rather than at Docker container names. Without this, both default to the
# hostnames "mosquitto", "postgres" and "redis", which only resolve inside
# a Docker network.
#
# Every port here sits ONE ABOVE the main cloud-robotics stack's
# (1883 / 6379 / 5432), so this sandbox and the full platform can run at the
# same time without fighting over a port. Keep it that way.
#
# INTERN TASK (security): these are committed defaults, reused verbatim by
# every copy of this project. That is exercise 11.

export MQTT_HOST=localhost
export MQTT_PORT=1884

export POSTGRES_HOST=localhost
export POSTGRES_PORT=5433
export POSTGRES_DB=robotstore
export POSTGRES_USER=robotstore
export POSTGRES_PASSWORD=robotstore

export REDIS_HOST=localhost
export REDIS_PORT=6380

export DEVICE_ID=demo-device-01
export PUBLISH_INTERVAL_SECONDS=1.0
export HEALTH_PORT=8081
export LOG_LEVEL=INFO

# INTERN TASK (security): wildcard CORS — exercise 8.
export CORS_ALLOWED_ORIGINS=*
