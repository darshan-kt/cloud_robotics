        <mxCell id="fe_au" value="&lt;b&gt;useAuth.ts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;localStorage session&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="1400" y="514" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="e1" value="PUBLISH  1 Hz  QoS 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#E65100;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#E65100;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ag_mq" target="brk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="SUBSCRIBE  devices/+/&amp;#8230;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="brk" target="be_svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="run_coroutine_threadsafe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="be_svc" target="be_st"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="SET latest &amp;#183; LPUSH/LTRIM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#00695C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#00695C;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="be_st" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#00695C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#00695C;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="be_st" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="LRANGE &amp;#8212; backfill on connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#00695C;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#00695C;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;dashPattern=6 4;" edge="1" parent="1" source="rds" target="be_ws"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="WSS frames &amp;#183; backfill &amp;#8594; live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5E35B1;strokeWidth=3;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="be_ws" target="fe_hk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="POST /auth/login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5E35B1;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe_lg" target="be_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="devices/{id}/cmd &amp;#8212; wired, unused" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;dashPattern=6 4;" edge="1" parent="1" source="brk" target="ag_mq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="history queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#00695C;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#00695C;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;dashPattern=6 4;" edge="1" parent="1" source="pg" target="be_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1n" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='color:#1565C0'&gt;WHY TWO STORES.&lt;/b&gt; &lt;span style='color:#5A6B7B'&gt;Postgres is the system of record &amp;#8212; losing a row would be a bug. Redis holds what is live and re-derivable: the latest value (another is one second away) and a 50-item ring buffer that populates a browser which just connected. The test for any new piece of data: &lt;b&gt;would losing this on restart be a bug?&lt;/b&gt; Yes &amp;#8594; Postgres. No &amp;#8594; Redis.&lt;/span&gt;&lt;br&gt;&lt;b style='color:#5E35B1'&gt;WHY TWO SOCKETS.&lt;/b&gt; &lt;span style='color:#5A6B7B'&gt;Multiplexing both kinds over one socket would be less code. Two makes the architecture visible: break one stream and exactly one window goes stale while the other keeps running.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1640" height="78" as="geometry"/></mxCell>
        <mxCell id="p1lg" value="&lt;div style='text-align:left;font-size:12px;color:#5A6B7B'&gt;Colour code: &amp;#160; &lt;b style='color:#5E35B1'&gt;operator&lt;/b&gt; &amp;#160;&amp;#183;&amp;#160; &lt;b style='color:#1565C0'&gt;cloud&lt;/b&gt; &amp;#160;&amp;#183;&amp;#160; &lt;b style='color:#E65100'&gt;robot-agent&lt;/b&gt; &amp;#160;&amp;#183;&amp;#160; &lt;b style='color:#00695C'&gt;data stores&lt;/b&gt; &amp;#160;&amp;#183;&amp;#160; &lt;b style='color:#C62828'&gt;security&lt;/b&gt; &amp;#160;&amp;#160;&amp;#8212;&amp;#160;&amp;#160; network &lt;b&gt;secure-robotstore-net&lt;/b&gt; (bridge) &amp;#183; volumes &lt;b&gt;postgres-data&lt;/b&gt;, &lt;b&gt;redis-data&lt;/b&gt;, &lt;b&gt;mosquitto-data&lt;/b&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#16202B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="1640" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sr02" name="02 · Data Path &amp; Thread Hand-off">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2hb" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=0;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1640" height="92" as="geometry"/></mxCell>
        <mxCell id="p2hbar" value="" style="rounded=0;fillColor=#1565C0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="10" height="92" as="geometry"/></mxCell>
        <mxCell id="p2ht" value="&lt;div style='text-align:left'&gt;&lt;span style='font-size:11px;letter-spacing:2px;color:#1565C0'&gt;&lt;b&gt;SECURE_ROBOTSTORE &amp;#183; DATA PATH&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:26px;color:#16202B'&gt;&lt;b&gt;02 &amp;#183; One reading&amp;#8217;s journey&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6B7B'&gt;Device to browser in eight steps. The thread hand-off in the middle is the part worth understanding before changing anything.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#16202B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="44" width="1580" height="70" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 &amp;#183; publisher._publish_once()&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;seq++ &amp;#183; UTC timestamp &amp;#183; random walk clamped 0..100. Next tick computed from a target time, not sleep(1), so 1 Hz does not drift.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 &amp;#183; client.publish(topic, json, qos=0)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Appends to paho&amp;#8217;s outgoing queue. Safe to call from either thread &amp;#8212; it touches no async state.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="256" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 &amp;#183; mosquitto routes the message&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;devices/demo-device-01/int matches the backend&amp;#8217;s devices/+/int subscription. Today it also matches anyone else&amp;#8217;s.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="342" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 &amp;#183; paho network thread fires _on_message&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;parse_topic() &amp;#8594; (device_id, kind). Malformed payload or unknown topic is dropped, not raised.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="428" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 &amp;#183; asyncio.run_coroutine_threadsafe(handler, loop)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;The hand-off. The loop was captured in connect(), which ran on the event loop.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6 &amp;#183; ReadingStore.record() &amp;#8212; now on the event loop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Thin validation: int coercion, str type check. Enough not to crash; not enough to be safe.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="642" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7 &amp;#183; fan out three ways&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Redis first, then Postgres (isolated), then Hub.publish() to every open socket.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="728" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;8 &amp;#183; ws/stream.py sends the frame&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;{&amp;quot;type&amp;quot;:&amp;quot;reading&amp;quot;} &amp;#8594; browser prepends the row and checks seq for gaps.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="814" width="620" height="72" as="geometry"/></mxCell>
        <mxCell id="f_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tb" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=0;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;arcSize=15;opacity=40;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="660" height="30" as="geometry"/></mxCell>
        <mxCell id="tbt" value="&lt;div style='text-align:left;font-size:12px;color:#C62828'&gt;&lt;b&gt;&amp;#9660; THREAD BOUNDARY&lt;/b&gt; &lt;span style='color:#5A6B7B'&gt;&amp;#8212; everything above runs on paho&amp;#8217;s network thread; everything below runs on the asyncio event loop. Calling an async handler directly across this line is the classic bug: it either does nothing or corrupts loop state.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#16202B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="52" y="516" width="1628" height="24" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;The 1 Hz you can trust&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B7B'&gt;Every reading carries a monotonic &lt;b&gt;seq&lt;/b&gt;. That is the debugging handle: a gap in the browser&amp;#8217;s sequence proves messages were dropped between the device and the screen &amp;#8212; otherwise indistinguishable from a slow device.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="730" y="170" width="950" height="150" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;One module owns the broker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B7B'&gt;mqtt/service.py is the only backend module that imports paho. Every other module reaches the device through it. One connection, one place to add TLS and credentials later.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="730" y="336" width="950" height="140" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Why Redis is written first&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B7B'&gt;A newly-connected browser reads Redis for its backfill, so being current there matters more than the durable write landing first. The Postgres write is wrapped separately so a database hiccup degrades the system to &amp;#8220;live data flows, history has a gap&amp;#8221; rather than killing the handler for every later reading too.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="730" y="556" width="950" height="160" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Bounded queues, on purpose&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B7B'&gt;Hub gives each socket its own queue with a maxsize. A browser on a slow link that stops draining must not make the producer grow a list forever &amp;#8212; when the queue is full the oldest reading is dropped, because for a live readout the newest value is the one that matters.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="730" y="732" width="950" height="150" as="geometry"/></mxCell>
        <mxCell id="p2n" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='color:#C62828'&gt;WHERE THIS PATH IS UNDEFENDED TODAY.&lt;/b&gt; &lt;span style='color:#5A6B7B'&gt;Step 2 needs no credential &amp;#8212; anyone reaching the broker can inject at this point. Step 3 applies no ACL, so the injected message is indistinguishable from the device&amp;#8217;s own. Step 4 calls json.loads() with no size cap, on the single event loop serving every browser. Step 6 caps no string length. Step 8 checks no token before accepting the socket. Five separate controls, five separate tasks &amp;#8212; see tab 03.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="908" width="1620" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sr03" name="03 · The Twelve Holes">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3hb" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=0;fontSize=12;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1640" height="92" as="geometry"/></mxCell>
        <mxCell id="p3hbar" value="" style="rounded=0;fillColor=#1565C0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="10" height="92" as="geometry"/></mxCell>
        <mxCell id="p3ht" value="&lt;div style='text-align:left'&gt;&lt;span style='font-size:11px;letter-spacing:2px;color:#1565C0'&gt;&lt;b&gt;SECURE_ROBOTSTORE &amp;#183; WHAT IS MISSING&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:26px;color:#16202B'&gt;&lt;b&gt;03 &amp;#183; The twelve holes&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5A6B7B'&gt;Nothing here is secure, and that is the point. Every gap is marked INTERN TASK in the source and has a working reference implementation in the main repo.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#16202B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="44" width="1580" height="70" as="geometry"/></mxCell>
        <mxCell id="h_ag" value="&lt;b&gt;robot-agent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=14;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="h_br" value="&lt;b&gt;mosquitto&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=14;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="370" y="214" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="h_be" value="&lt;b&gt;backend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=14;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="700" y="214" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="h_ds" value="&lt;b&gt;Redis / Postgres&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=14;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="1030" y="214" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="h_fe" value="&lt;b&gt;browser&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=14;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1"><mxGeometry x="1360" y="214" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="hf_h_ag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h_ag" target="h_br"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hf_h_br" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h_br" target="h_be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hf_h_be" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h_be" target="h_ds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="hf_h_ds" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h_ds" target="h_fe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m0" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="173" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="437" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="481" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m3" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="525" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m4" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="569" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m5" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="745" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m6" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="789" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m7" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="833" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m8" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="877" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m9" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="921" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m10" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="1163" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="m11" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#FFFFFF;shadow=0;" vertex="1" parent="1"><mxGeometry x="1493" y="316" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="p3h" value="&lt;div style='text-align:left;font-size:12px;color:#5A6B7B'&gt;&lt;b style='color:#C62828'&gt;&amp;#9679;&lt;/b&gt; Each marker sits on the component that carries the gap. Suggested order is 1 &amp;#8594; 12; each step has a reference implementation named on its card.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#16202B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="1640" height="26" as="geometry"/></mxCell>
        <mxCell id="tc1" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;MQTT authentication&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;allow_anonymous false, a password file, per-client credentials generated at container start.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;cloud-container/mosquitto/&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc2" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;MQTT topic ACL&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Device may only write telemetry; backend may only write commands. Direction is the security property.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;cloud-container/mosquitto/aclfile&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="453" y="412" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc3" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Real password storage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Users in Postgres, hashed, constant-time compare, one generic error for every failure.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/auth/service.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="866" y="412" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc4" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Real tokens&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Signed JWT with sub/iat/exp/jti, verified server-side. Today it is base64 of the username.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/auth/tokens.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1279" y="412" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc5" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Protect the endpoints&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;An auth dependency on every REST route AND both WebSocket upgrades. The route guard in App.tsx protects nothing.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/auth/dependencies.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc6" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Login rate limiting&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Redis-backed attempt counter plus a lockout key. The endpoint can currently be guessed at line speed.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/auth/rate_limit.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="453" y="562" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc7" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;7&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Input size limits&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;message_size_limit at the broker, a byte cap before json.loads(), a value cap in the store.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/mqtt/service.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="866" y="562" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc8" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;CORS + security headers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Explicit origin allowlist; CSP, HSTS, nosniff, frame-deny on the API and at nginx.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/security_headers.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1279" y="562" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc9" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;9&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;TLS everywhere&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Broker on 8883, TLS to Postgres and Redis, HTTPS at the edge. tls_set() BEFORE connect_async().&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;scripts/generate-dev-certs.sh&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc10" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Container hardening&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Non-root users, no-new-privileges, loopback-only port bindings, resource limits.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;root docker-compose.yml&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="453" y="712" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc11" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;11&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Secrets&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Nothing committed; generated per environment; a startup guard that refuses known defaults in production.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;scripts/generate-secrets.sh&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="866" y="712" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="tc12" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;span style='font-size:11px;color:#C62828'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/span&gt; &amp;#160;&lt;b style='font-size:13px'&gt;Audit logging&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#5A6B7B'&gt;Append-only, hash-chained record of every auth event, so tampering is detectable by recomputation.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#C62828'&gt;&lt;b&gt;COMPARE AGAINST&lt;/b&gt; &amp;#160;.../app/audit/logger.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1279" y="712" width="401" height="138" as="geometry"/></mxCell>
        <mxCell id="p3n" value="&lt;div style='text-align:left;line-height:1.6'&gt;&lt;b style='color:#C62828'&gt;SEE THE HOLES BEFORE FIXING THEM.&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5A6B7B'&gt;&lt;b&gt;1 &amp;#183; Forge a reading, no credentials.&lt;/b&gt; &amp;#160;docker run --rm --network secure-robotstore_secure-robotstore-net eclipse-mosquitto:2 mosquitto_pub -h mosquitto -t devices/demo-device-01/int -m '{&amp;quot;value&amp;quot;:999,&amp;quot;seq&amp;quot;:999999}' &amp;#8212; then find it in Postgres, permanently.&lt;br&gt;&lt;b&gt;2 &amp;#183; Read all traffic.&lt;/b&gt; &amp;#160;mosquitto_sub -h mosquitto -t 'devices/#' -v&lt;br&gt;&lt;b&gt;3 &amp;#183; Call the API signed out.&lt;/b&gt; &amp;#160;curl localhost:8001/api/string/history &amp;#8594; 200&lt;br&gt;&lt;br&gt;All three run together as &lt;b&gt;make verify-holes&lt;/b&gt;. After each fix, re-run: the attack should fail and the app should still work. Either half alone is easy &amp;#8212; the combination is the pass condition.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=12;fontColor=#16202B;verticalAlign=top;align=left;shadow=0;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="1640" height="118" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
