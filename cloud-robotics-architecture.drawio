          <mxGeometry x="1430" y="402" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l45" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;angular &amp;#8722;0.50&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="1430" y="420" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p46" value="stop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="458" width="130" height="46" as="geometry" />
        </mxCell>
        <mxCell id="l47" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;0.00&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="1430" y="464" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l48" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;0.00&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="1430" y="482" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nt49" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;Left and right are pure in-place rotation — the simplest orthogonal reading of five discrete commands, isolated in one function. A curved turn later is a one-function edit. Unknown commands are logged and rejected, never raised.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="528" width="368" height="96" as="geometry" />
        </mxCell>
        <mxCell id="band50" value="THE DEPENDENCY-INJECTION PAYOFF, MADE CONCRETE" style="rounded=1;arcSize=3;fillColor=#F4FBF5;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2E7D32;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="1640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c51" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;interfaces.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;class ROSAdapter(ABC)&lt;/code&gt;&lt;br&gt;publish_cmd_vel · subscribe_camera&lt;br&gt;subscribe_odometry · subscribe_battery&lt;br&gt;subscribe_diagnostics&lt;br&gt;&lt;b&gt;Zero ROS2 imports.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="722" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c52" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;main.py &amp;nbsp;·&amp;nbsp; today&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;ros_adapter = MockROSAdapter(&lt;/code&gt;&lt;br&gt;&lt;code&gt;&amp;nbsp;&amp;nbsp;robot_id=config.robot_id)&lt;/code&gt;&lt;br&gt;&lt;br&gt;Not a test double — this is what actually runs in the container right now.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="490" y="722" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c53" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;main.py &amp;nbsp;·&amp;nbsp; Milestone 5&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;ros_adapter = RealROSAdapter(&lt;/code&gt;&lt;br&gt;&lt;code&gt;&amp;nbsp;&amp;nbsp;robot_id=…, node=ros_node)&lt;/code&gt;&lt;br&gt;&lt;br&gt;A four-line change. Nothing in agent.py or dispatcher.py moves.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="906" y="722" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nt54" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;That is what &#39;use interfaces and DI&#39; actually &lt;b&gt;buys&lt;/b&gt; you: a component fully built, running and testable before its riskiest dependency — ROS2 + Gazebo + Turtlebot3 — even exists.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1322" y="722" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c51" target="c52">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e56" value="swap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c53">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nt57" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Two &#39;health&#39; concepts, on purpose.&lt;/b&gt; &lt;code&gt;robots/{id}/health&lt;/code&gt; over MQTT reports to the &lt;i&gt;fleet backend&lt;/i&gt; — CPU, memory, temperature. &lt;code&gt;GET /health&lt;/code&gt; on :8080 reports to the &lt;i&gt;container orchestrator&lt;/i&gt; — Docker&#39;s HEALTHCHECK today, an ECS or Kubernetes probe later. They look similar and answer different questions for different audiences.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="810" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nt58" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Mixed sync/async, not &#39;everything async&#39;.&lt;/b&gt; &lt;code&gt;connect()&lt;/code&gt;, &lt;code&gt;run()&lt;/code&gt; and &lt;code&gt;restart()&lt;/code&gt; are async because they coordinate genuinely concurrent long-lived work. &lt;code&gt;heartbeat()&lt;/code&gt; and &lt;code&gt;receive_command()&lt;/code&gt; stay synchronous — the latter is invoked straight from paho&#39;s own callback thread, and routing it through the event loop would bridge every command across threads for no benefit.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF9F2;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="900" width="800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l59" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/04-robot-agent.md · 17 unit tests, well under a second, no Docker, no broker, no ROS2&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg10" name="M5 · ROS2 + Gazebo">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr1" value="" style="rounded=1;arcSize=6;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=0;html=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1640" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bar2" value="" style="rounded=0;fillColor=#E65100;strokeColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="10" height="92" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#E65100&quot;&gt;&lt;b&gt;MILESTONE 5&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;ROS2 &amp;amp; Turtlebot3 integration&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;&lt;code&gt;RealROSAdapter&lt;/code&gt; replaces the mock. Real physics, real odometry — and exactly one file in &lt;code&gt;robot_agent/&lt;/code&gt; changed.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="78" y="30" width="1460" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bg4" value="5" style="ellipse;fillColor=#E65100;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=22;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="46" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="INSIDE THE ROBOT CONTAINER" style="rounded=1;arcSize=3;fillColor=#FFF9F2;strokeColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#E65100;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1080" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;entrypoint.sh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Sources &lt;b&gt;three&lt;/b&gt; environments:&lt;br&gt;1. /opt/ros/humble/setup.bash&lt;br&gt;2. ros_ws/install/setup.bash&lt;br&gt;3. &lt;b&gt;/usr/share/gazebo/setup.sh&lt;/b&gt;&lt;br&gt;&lt;br&gt;Then launches the simulation in the background and &lt;code&gt;exec&lt;/code&gt;s the agent as PID 1.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="212" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;simulation.launch.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;gzserver&lt;/code&gt; only — never includes gzclient.launch.py at all, so a GUI is &lt;i&gt;structurally&lt;/i&gt; impossible rather than argument-dependent.&lt;br&gt;&lt;br&gt;Reuses turtlebot3_gazebo&#39;s own robot_state_publisher and spawn launch files.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="410" y="212" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;RealROSAdapter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The only place rclpy is imported. A SingleThreadedExecutor spins the rclpy.Node on its own background thread; subscription handlers read whatever callback is currently stored — the &lt;i&gt;same calling contract&lt;/i&gt; the mock had.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="746" y="212" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9" value="/cmd_vel &amp;nbsp;(Twist) &amp;nbsp;&amp;#8594;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="412" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p10" value="&amp;#8592; &amp;nbsp;/odom &amp;nbsp;(quaternion &amp;#8594; yaw)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="410" y="412" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p11" value="&amp;#8592; &amp;nbsp;/scan &amp;nbsp;·&amp;nbsp; /camera/image_raw" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="746" y="412" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Turtlebot3 &lt;b&gt;waffle_pi&lt;/b&gt;, not burger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;burger is lighter and more common in tutorials — and has no camera. Since the second data path is camera &amp;#8594; GStreamer &amp;#8594; WebRTC &amp;#8594; browser, burger simply cannot fulfil the spec. Choosing waffle_pi now means Milestone 6 swaps nothing out from under anything.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="492" width="1012" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#E65100;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#E65100;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#E65100;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#E65100;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="band15" value="THE ONE-LINE SWAP" style="rounded=1;arcSize=3;fillColor=#F4FBF5;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2E7D32;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="160" width="520" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;robot_agent/main.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;- ros_adapter = MockROSAdapter(…)&lt;/code&gt;&lt;br&gt;&lt;code&gt;+ ros_adapter = RealROSAdapter(…)&lt;/code&gt;&lt;br&gt;&lt;br&gt;agent.py · dispatcher.py · every unit test — untouched.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="212" width="464" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Two mechanisms, one contract&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A &lt;code&gt;time.sleep&lt;/code&gt; loop (mock) versus a DDS-backed ROS2 executor (real). Completely different underneath, identical from the caller&#39;s side. That is why zero lines in agent.py changed. &lt;b&gt;The abstraction held.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="338" width="464" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Honest stubs, not invented numbers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Turtlebot3&#39;s Gazebo stack has no /battery_state or /diagnostics topics to bridge. Those adapter methods are logged stubs and telemetry reports &lt;code&gt;null&lt;/code&gt; — which is correct, not a bug.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="464" width="464" height="94" as="geometry" />
        </mxCell>
        <mxCell id="band19" value="WHAT ACTUALLY BROKE  —  and why the third one is worth remembering" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="612" width="1640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Bug 1 &amp;nbsp;·&amp;nbsp; wrong git branch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The Dockerfile cloned turtlebot3_simulations on &lt;code&gt;humble-devel&lt;/code&gt;, which does not exist on that repo. &lt;code&gt;git ls-remote&lt;/code&gt; showed the real branch is just &lt;code&gt;humble&lt;/code&gt;. One line, caught immediately by a fast, clear build failure.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="664" width="500" height="175" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Bug 2 &amp;nbsp;·&amp;nbsp; &lt;code&gt;set -u&lt;/code&gt; vs ROS2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;ROS2&#39;s own setup.bash references &lt;code&gt;AMENT_TRACE_SETUP_FILES&lt;/code&gt; with no default — normal for an interactive shell, fatal under &lt;code&gt;set -euo pipefail&lt;/code&gt;. Container crash-looped instantly. Drop &lt;code&gt;-u&lt;/code&gt;, keep &lt;code&gt;-e&lt;/code&gt; and pipefail.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="614" y="664" width="500" height="175" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Bug 3 &amp;nbsp;·&amp;nbsp; the real one&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;spawn_entity.py&lt;/code&gt; timed out: &lt;i&gt;&#39;Was Gazebo started with GazeboRosFactory?&#39;&lt;/i&gt; — even though &lt;code&gt;-s libgazebo_ros_factory.so&lt;/code&gt; was clearly on the command line. Live inside the container: &lt;code&gt;GAZEBO_PLUGIN_PATH&lt;/code&gt; was &lt;b&gt;empty&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1154" y="664" width="500" height="175" as="geometry" />
        </mxCell>
        <mxCell id="nt23" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;The lesson generalises.&lt;/b&gt; &lt;code&gt;entrypoint.sh&lt;/code&gt; sourced ROS2&#39;s environment and the workspace&#39;s — but never &lt;code&gt;/usr/share/gazebo/setup.sh&lt;/code&gt;, which is &lt;b&gt;Gazebo&#39;s own&lt;/b&gt;, entirely separate from anything ROS-flavoured and easy to not know exists if you have only ever worked the ROS2 side of a ROS2+Gazebo stack. A ROS2+Gazebo container has &lt;i&gt;two&lt;/i&gt; environments to source, and only one of them has &#39;ROS&#39; in its name.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="888" width="1640" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l24" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/05-ros2-integration.md · Image grew 773MB &amp;#8594; 3.81GB (a real simulator, not a regression) · position moved &amp;#8722;1.9999 &amp;#8594; &amp;#8722;1.3502 under a real &#39;forward&#39;, with non-round velocities — the signature of real physics&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
