        <mxCell id="c7" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;POST /robots/{id}/webrtc/offer {sdp}&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="74" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b8" parent="1" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" value="2" vertex="1">
