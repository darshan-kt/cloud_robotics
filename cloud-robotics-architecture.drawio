          <mxGeometry x="70" y="302" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l11" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;Exclusive per-robot control locks.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="310" width="490" height="32" as="geometry" />
