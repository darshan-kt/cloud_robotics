        <mxCell id="l20" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#5A6B7B&quot;&gt;SET NX EX is standard Redis, nothing special needed&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
