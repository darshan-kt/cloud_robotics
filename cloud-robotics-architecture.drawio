        </mxCell>
        <mxCell id="t3" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#2E7D32&quot;&gt;&lt;b&gt;MILESTONE 8&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;WebRTC signalling&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;The throwaway dev HTTP server is deleted. Real, MQTT-mediated signalling through the backend — the same boundary every other robot interaction already respects.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="1460" x="78" y="30" as="geometry" />
        </mxCell>
