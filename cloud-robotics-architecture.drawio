        <mxCell id="e48" edge="1" parent="1" source="c37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;spacingTop=-2;dashPattern=6 4;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;" target="c31" value="ICE">
