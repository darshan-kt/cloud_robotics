          <mxGeometry x="40" y="30" width="10" height="92" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#C62828&quot;&gt;&lt;b&gt;POST-MILESTONE 11&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;Security hardening&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;An audit of everything Milestones 1–11 shipped, done by reading the actual code rather than trusting earlier &#39;worth revisiting&#39; comments. They had not been revisited.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="78" y="30" width="1460" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bg4" value="12" style="ellipse;fillColor=#C62828;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=22;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="46" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="ELEVEN FINDINGS, RANKED BY HOW BAD LEAVING THEM WOULD HAVE BEEN" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1640" height="480" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="1" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="200" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Redis had no password, port on 0.0.0.0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;Session locks and live fleet state readable and &lt;b&gt;writable&lt;/b&gt; by anyone who could reach 6379 — bypassing JWT, session ownership and the audit trail at once.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; requirepass + loopback binding. &lt;code&gt;redis-cli ping&lt;/code&gt; from outside now gets NOAUTH.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="208" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="2" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="604" y="200" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Postgres / Redis / Mosquitto bound to 0.0.0.0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;For no operational reason — the backend and robot reach them by service name on the internal network. The host ports exist only for local debugging.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; All three now bind 127.0.0.1.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="208" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="3" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1144" y="200" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;/auth/login had no rate limiting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;One shared credential plus unlimited attempts is a brute-force invitation.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; Redis counter per IP. 5 failures in 5 min &amp;#8594; a 5-minute lockout. A &lt;i&gt;correct&lt;/i&gt; password during lockout still gets 429 — that is what stops a slow script.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1150" y="208" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b12" value="4" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="308" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;CORS was allow_origins=[&quot;*&quot;]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;Not a classic cookie-CSRF hole (auth is an explicit bearer token) — but a wildcard still let any origin that got a request through read the response.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; CORS_ALLOWED_ORIGINS, default http://localhost:3000.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="316" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b14" value="5" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="604" y="308" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;JWTs could not be revoked&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;No logout, no jti, no blacklist. A stolen token rode out its full hour regardless of what the operator did.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; Random jti + POST /auth/logout + Redis blacklist with TTL = the token&#39;s own remaining life. Default lifetime 3600s &amp;#8594; 1800s.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="316" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b16" value="6" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1144" y="308" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;The JWT travelled in the WebSocket URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;A long-lived credential in a URL ends up in access logs, proxy logs and browser history. The code&#39;s own comments already flagged it.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; POST /auth/ws-ticket &amp;#8594; a 15-second, single-use ticket consumed by an atomic GETDEL.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1150" y="316" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b18" value="7" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="416" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;No durable record of who commanded what&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;Commands — including emergency stop — and session events were only ever logger.info()&#39;d. Neither durable across a restart nor evidence against a deliberate edit.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; audit_log, hash-chained, appends serialised with a Postgres advisory lock. verify-audit-log.py walks it.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="424" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b20" value="8" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="604" y="416" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Containers ran as root&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;No Linux capabilities dropped anywhere.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; Backend runs as non-root appuser uid 1000; no-new-privileges on every service; cap_drop ALL on backend and frontend.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="424" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b22" value="9" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1144" y="416" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;No security response headers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;Not on the API, not on the frontend.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; X-Content-Type-Options, X-Frame-Options DENY, Referrer-Policy, a default-src &#39;none&#39; CSP, Cache-Control no-store on /auth/*.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1150" y="424" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b24" value="10" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="524" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;No guard against booting with a dev secret&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;&lt;code&gt;JWT_SECRET=dev-only-insecure-secret-change-me&lt;/code&gt; would boot silently anywhere. A comment telling a human to change it is not a control.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; assert_production_safe() raises at import time under ENVIRONMENT=production.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="532" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b26" value="11" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="604" y="524" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;No backstop on the command channel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;span style=&#39;color:#B71C1C&#39;&gt;Only the frontend&#39;s own client-side 20 cmd/s throttle stood between an operator token and an unbounded flood.&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;color:#1B5E20&#39;&gt;&amp;#10003; Redis fixed window per (operator, robot_id), 40/s. &lt;b&gt;stop is exempt&lt;/b&gt; — a safety override that could be rate-limited away by the very flood it interrupts would defeat itself.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="532" width="505" height="92" as="geometry" />
        </mxCell>
        <mxCell id="band29" value="ONE THING THE AUDIT CONFIRMED WAS ALREADY SOLID" style="rounded=1;arcSize=3;fillColor=#F4FBF5;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2E7D32;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="668" width="810" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;The command channel has no injection surface&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Command payloads are a closed Pydantic &lt;code&gt;Literal[&quot;forward&quot;,&quot;backward&quot;,&quot;left&quot;,&quot;right&quot;,&quot;stop&quot;]&lt;/code&gt;. Nothing to escape, nothing to smuggle. Worth recording explicitly — an audit that only lists problems tells you nothing about what was checked and found fine.&lt;br&gt;&lt;br&gt;Also: &lt;code&gt;pip-audit&lt;/code&gt; found real, fixable CVEs in PyJWT 2.9.0 and (transitively via fastapi) starlette 0.38.6 — both bumped and re-audited clean, with the full backend suite run against both the pre- and post-upgrade environments.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="714" width="750" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nt31" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Deliberately still open — not forgotten, and not implied to be covered.&lt;/b&gt;&lt;br&gt;· &lt;b&gt;MQTT transport security.&lt;/b&gt; The broker still speaks plaintext on the internal network; credentials are per-role passwords, not certificates. TLS (ideally mTLS) is also exactly the shape AWS IoT Core expects.&lt;br&gt;· &lt;b&gt;Real per-operator accounts.&lt;/b&gt; Still one shared credential. The audit log already records &lt;i&gt;whichever&lt;/i&gt; username authenticated, so it is ready for this.&lt;br&gt;· &lt;b&gt;Centralised, immutable log shipping.&lt;/b&gt; The hash chain proves tampering after the fact from one table snapshot. An attacker with a live DB connection and patience could rewrite the chain forward and still pass the verifier.&lt;br&gt;· &lt;b&gt;CI security gates&lt;/b&gt;, a &lt;b&gt;secrets manager&lt;/b&gt;, full cap_drop for the heavy containers, the react-router major bump, a precise CSP connect-src — and &lt;b&gt;a real third-party penetration test&lt;/b&gt; before any non-simulation deployment.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="668" width="798" height="210" as="geometry" />
        </mxCell>
        <mxCell id="nt32" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Everything above was checked against the live stack, not just written down.&lt;/b&gt; The full 401/429 lockout sequence exercised with curl. Login &amp;#8594; authenticated GET /robots (200) &amp;#8594; logout (204) &amp;#8594; the same token reused (401 &#39;Token has been revoked&#39;) &amp;#8594; a fresh login works. A real Python &lt;code&gt;websockets&lt;/code&gt; client proved a ticket is genuinely single-use (403 on reuse). &lt;code&gt;verify-audit-log.py&lt;/code&gt; reported a clean chain, then correctly pinpointed a manually corrupted row after the fact. &lt;code&gt;docker exec … id&lt;/code&gt; &amp;#8594; &lt;code&gt;uid=1000(appuser)&lt;/code&gt;, not root.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="908" width="1640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l33" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/12-security-hardening.md · Nothing here changes what the platform does. It changes what happens when someone tries to abuse it.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
