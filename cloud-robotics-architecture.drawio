        </mxCell>
        <mxCell id="l13" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;The backend&#39;s own /health and /metrics&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="288" y="436" width="430" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p14" value="/settings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l15" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;Real session identity and runtime config — not a form that saves nothing&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="288" y="508" width="430" height="48" as="geometry" />
        </mxCell>
        <mxCell id="band16" value="HOOKS" style="rounded=1;arcSize=3;fillColor=#F8F5FF;strokeColor=#5E35B1;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#5E35B1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="768" y="160" width="460" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;useStatusSocket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;/ws/status &amp;nbsp;·&amp;nbsp; &lt;b&gt;auto-reconnects&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="212" width="404" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;useTeleopSocket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;/ws/teleop &amp;nbsp;·&amp;nbsp; &lt;b&gt;deliberately does not&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="284" width="404" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;useThrottledTeleop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The one shared 20 Hz start/stop throttle&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="356" width="404" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;useKeyboardTeleop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Arrows / WASD &amp;#8594; the same throttle; ignores form fields&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="428" width="404" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;useWebRTCVideo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The offer/answer flow; iceServers from runtime config&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="500" width="404" height="60" as="geometry" />
        </mxCell>
        <mxCell id="band22" value="TWO DELIBERATE ASYMMETRIES" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1256" y="160" width="424" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Why teleop must not auto-reconnect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The status socket backs a dashboard — a few stale seconds is a blemish. The teleop socket backs an &lt;b&gt;exclusive control session&lt;/b&gt;. Silently reopening it after a drop would re-acquire the operator&#39;s session behind their back — possibly stealing it from whoever legitimately took over in the gap. So a drop surfaces in the UI and hands control back to an explicit &lt;b&gt;Take control&lt;/b&gt; button.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="212" width="368" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Why video is enabled and control is not&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;useWebRTCVideo&lt;/code&gt; is enabled unconditionally once the page mounts. &lt;code&gt;useTeleopSocket&lt;/code&gt; connects only when the operator clicks Take control.&lt;br&gt;&lt;br&gt;Getting this backwards — auto-acquiring the lock just to show video — would silently take the session away from whoever is supposed to have it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="388" width="368" height="172" as="geometry" />
        </mxCell>
        <mxCell id="band25" value="THREE REAL WEBRTC BUGS, FOUND ONLY BY A REAL BROWSER" style="rounded=1;arcSize=3;fillColor=#F4FBF5;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2E7D32;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1640" height="290" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Pass 1 · stuck at &#39;negotiating&#39; forever&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;code&gt;ontrack&lt;/code&gt; fired and a MediaStream was assigned, yet &lt;code&gt;readyState&lt;/code&gt; stayed at 0. Chrome&#39;s offer advertised &lt;b&gt;only mDNS-obfuscated host candidates&lt;/b&gt; (&lt;i&gt;ea9787….local&lt;/i&gt;) — a years-old default privacy feature. The robot&#39;s libnice stack had no way to resolve them.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; a coturn TURN relay in compose and in &lt;code&gt;iceServers&lt;/code&gt;. A relay candidate is never obfuscated. Not a dev workaround — a real robot behind NAT needs it for the same reason.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="660" width="500" height="226" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Pass 2 · the &lt;i&gt;second&lt;/i&gt; connection went silent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;A page reload produced a second RTCPeerConnection and a second offer — and that one got stuck, while &lt;code&gt;rtp_packets_sent&lt;/code&gt; froze. Milestones 6 and 8 never exercised this: both used exactly one offer per process by construction.&lt;br&gt;&lt;br&gt;&lt;b&gt;Root cause:&lt;/b&gt; one &lt;code&gt;webrtcbin&lt;/code&gt; for the whole process, mutated in place on a later offer. webrtcbin models exactly one peer connection; a second &lt;code&gt;set-remote-description&lt;/code&gt; corrupts the first one&#39;s ICE state.&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; &lt;code&gt;_prepare_fresh_webrtcbin()&lt;/code&gt; — tear down, build new, every time.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="614" y="660" width="500" height="226" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Pass 4 · the race was narrowed, not closed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;Building the LiDAR panel meant dozens of reconnects an hour instead of a few per test run. That volume showed ~1 in 10–15 still hit &lt;code&gt;streaming stopped, reason not-linked&lt;/code&gt; — and once it happened, the singleton encode chain stayed wedged for &lt;i&gt;every&lt;/i&gt; later offer.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; a &lt;code&gt;BLOCK_DOWNSTREAM&lt;/code&gt; pad probe before unlinking, waiting for the pad to quiesce. Stress-tested at 16 rapid reconnects: &lt;b&gt;2 then 14 failures before; 16/16 after.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1154" y="660" width="500" height="226" as="geometry" />
        </mxCell>
        <mxCell id="nt29" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;And one loose end only real hardware surfaced.&lt;/b&gt; The pass-2 refactor left a stale &lt;code&gt;sync_state_with_parent()&lt;/code&gt; call behind. It threw once, on the very first camera frame, got caught and logged — and because &lt;code&gt;self._pipeline&lt;/code&gt; was already assigned before the crash, every later frame skipped the builder entirely and pushed into an already-PLAYING pipeline. A real ERROR stack trace on every startup with zero observable effect on anything the verification checked. Testing against a physically-attached webcam (not the synthetic pattern) surfaced it immediately. &lt;b&gt;24/24 substantive checks passed.&lt;/b&gt;&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l30" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/09-frontend.md · The LidarView panel is a plain &amp;lt;canvas&amp;gt; — no charting library, the same &#39;a native API already does the job&#39; call as &amp;lt;video&amp;gt; for camera&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg15" name="M10 · Testing Strategy">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr1" value="" style="rounded=1;arcSize=6;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=0;html=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1640" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bar2" value="" style="rounded=0;fillColor=#546E7A;strokeColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="10" height="92" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#546E7A&quot;&gt;&lt;b&gt;MILESTONE 10&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;Testing strategy&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;Every layer has a real test behind it, and they run together, in the right order, against a live three-container stack, with one command.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="78" y="30" width="1460" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bg4" value="10" style="ellipse;fillColor=#546E7A;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=22;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="46" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="80 TESTS, THREE LAYERS" style="rounded=1;arcSize=3;fillColor=#FAFBFC;strokeColor=#7A8896;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#7A8896;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1080" height="470" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="32" style="ellipse;fillColor=#E65100;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="74" y="250" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;robot-container/tests/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Pure unit tests. No Docker, no broker, no ROS2 — FakeMQTTClient and RecordingROSAdapter test doubles. Well under a second.&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;test_dispatcher · test_agent · test_mock_ros_adapter · test_sdp_utils&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="142" y="210" width="950" height="122" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="48" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="74" y="388" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;cloud-container/tests/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Unit + live integration + a real-browser end-to-end run against real Postgres, real Redis, a real broker and a real robot.&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;test_auth · test_fleet_manager · test_mqtt_acl · test_webrtc_relay · test_registry_and_sessions_live · test_api_live · test_frontend_e2e&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="142" y="348" width="950" height="122" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="1" style="ellipse;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="74" y="526" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;scripts/run-integration-tests.sh&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;One command. Copies tests &lt;i&gt;and&lt;/i&gt; pytest.ini into the live robot container, installs pinned deps, runs both suites in order.&lt;br&gt;&lt;br&gt;&lt;span style=&#39;font-size:9px&#39;&gt;--up / --down flags · clear exit codes · CI-ready&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="142" y="486" width="950" height="122" as="geometry" />
        </mxCell>
        <mxCell id="band12" value="WHY REAL CHROME" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="160" width="520" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;A mocked RTCPeerConnection would have caught neither bug&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A component test with Jest / React Testing Library proves the React code renders the right JSX for a given hook state. Both of Milestone 9&#39;s real bugs lived in actual browser ICE and WebRTC behaviour that no mock reproduces.&lt;br&gt;&lt;br&gt;&lt;code&gt;channel=&quot;chrome&quot;&lt;/code&gt; specifically, not Playwright&#39;s bundled Chromium — the mDNS candidate behaviour is a real-Chrome privacy feature.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="212" width="464" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Prove it against the &lt;i&gt;robot&#39;s&lt;/i&gt; metrics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A button showing &#39;active&#39;, or a socket returning &lt;code&gt;{&quot;status&quot;:&quot;sent&quot;}&lt;/code&gt;, proves the browser &lt;i&gt;tried&lt;/i&gt;. &lt;code&gt;test_full_operator_journey&lt;/code&gt; reads &lt;code&gt;commands_received&lt;/code&gt; off the robot&#39;s own /metrics before and after every teleop action — so the assertion is about the robot, not the browser&#39;s opinion of itself.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="408" width="464" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;One regression test kept separate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;test_webrtc_survives_reload_and_renavigation&lt;/code&gt; exists &lt;i&gt;because&lt;/i&gt; that exact scenario once broke silently.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="554" width="464" height="66" as="geometry" />
        </mxCell>
        <mxCell id="band16" value="A REAL GAP THE RUNNER ITSELF FOUND" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;The claim&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Earlier milestone summaries said &#39;32/32 robot tests pass&#39;.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="710" width="372" height="176" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Run it the way a contributor would&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;docker compose exec&lt;/code&gt; into the real, built robot container: &lt;b&gt;27 passed, 5 skipped&lt;/b&gt; — not failed, which is why nobody noticed.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="478" y="710" width="372" height="176" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Why&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;pytest-asyncio&lt;/code&gt; needs &lt;code&gt;asyncio_mode = auto&lt;/code&gt; to run bare &lt;code&gt;async def&lt;/code&gt; tests. That setting lives in &lt;code&gt;robot-container/pytest.ini&lt;/code&gt; — and pytest.ini was &lt;b&gt;never copied into the container&lt;/b&gt;, the same deliberate exclusion as tests/ itself.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="710" width="372" height="176" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Closed for real&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The runner copies both, and installs pinned pytest 8.3.3 / pytest-asyncio 0.24.0 — the container&#39;s system pytest is an ancient 6.2.5 from the ROS2 Humble apt packages.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1286" y="710" width="372" height="176" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l24" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/10-testing-strategy.md · === ALL SUITES PASSED === &amp;nbsp;·&amp;nbsp; robot 32 in 0.69s, cloud 48 in 45.70s &amp;nbsp;·&amp;nbsp; noted, not blocking: no CI provider actually invokes it yet&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
