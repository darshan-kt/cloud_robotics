        <mxCell id="c11" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;MQTT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;publish robots/{id}/camera/offer&lt;br&gt;{request_id, sdp} &amp;nbsp;QoS 1&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="74" y="312" as="geometry" />
        </mxCell>
        <mxCell id="b12" parent="1" style="ellipse;fillColor=#E65100;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" value="4" vertex="1">
          <mxGeometry height="26" width="26" x="590" y="304" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;_on_camera_offer &amp;#8594; threading.Thread(…)&lt;br&gt;returns immediately&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="596" y="312" as="geometry" />
        </mxCell>
        <mxCell id="b14" parent="1" style="ellipse;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" value="5" vertex="1">
          <mxGeometry height="26" width="26" x="68" y="404" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;VideoStreamer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;handle_offer(sdp) — blocks ~10s&lt;br&gt;on full ICE gathering&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="74" y="412" as="geometry" />
        </mxCell>
        <mxCell id="b16" parent="1" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" value="6" vertex="1">
          <mxGeometry height="26" width="26" x="590" y="404" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;MQTT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;publish robots/{id}/camera/answer&lt;br&gt;{&lt;b&gt;same request_id&lt;/b&gt;, sdp} &amp;nbsp;QoS 1&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="596" y="412" as="geometry" />
        </mxCell>
        <mxCell id="b18" parent="1" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" value="7" vertex="1">
          <mxGeometry height="26" width="26" x="68" y="504" as="geometry" />
        </mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;relay.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;handle_answer() resolves the&lt;br&gt;matching Future&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="74" y="512" as="geometry" />
        </mxCell>
        <mxCell id="b20" parent="1" style="ellipse;fillColor=#5E35B1;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" value="8" vertex="1">
          <mxGeometry height="26" width="26" x="590" y="504" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;HTTP 200 {sdp} &amp;#8594; setRemoteDescription&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="488" x="596" y="512" as="geometry" />
        </mxCell>
        <mxCell id="band23" parent="1" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" value="THE FOUR DESIGN QUESTIONS" vertex="1">
          <mxGeometry height="460" width="520" x="1160" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Why a hand-rolled request_id?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;MQTT 3.1.1 has no idea that &#39;this message replies to that one&#39;. An HTTP request correlates itself — the deleted dev server never had to think about it. Over pub/sub, the smallest version of that correlation is built by hand. Proven correct for &lt;i&gt;concurrent&lt;/i&gt; independent offers, not just the single-request case.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="464" x="1188" y="212" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Why a thread per offer on the robot?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;&lt;code&gt;handle_offer()&lt;/code&gt; genuinely blocks for up to ~10 seconds. MQTT callbacks run on the client&#39;s own network thread — running it there would stall &lt;i&gt;every other inbound message&lt;/i&gt; for that whole window, including the next &lt;code&gt;cmd&lt;/code&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="464" x="1188" y="312" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Why REST, not a WebSocket, browser-side?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;The project already has the precedent: REST for one discrete command, WebSocket for a continuous stream. An offer/answer exchange is fundamentally &lt;b&gt;one-shot&lt;/b&gt;, once per viewing session. Trickle ICE would change that calculus; non-trickle does not need it.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="464" x="1188" y="412" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;Why does watching not need the control session?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5A6B7B&quot;&gt;Path 1 and Path 2 are independent by design. An operator who only wants to &lt;i&gt;watch&lt;/i&gt; a robot someone else is driving should not have to fight them for the lock first.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="464" x="1188" y="512" as="geometry" />
        </mxCell>
        <mxCell id="band28" parent="1" style="rounded=1;arcSize=3;fillColor=#FAFBFC;strokeColor=#7A8896;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#7A8896;shadow=0;" value="WHAT WAS ADDED, AND WHAT WAS DELETED" vertex="1">
          <mxGeometry height="240" width="810" x="40" y="650" as="geometry" />
        </mxCell>
        <mxCell id="ch29" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="+ &amp;nbsp;aclfile: camera split into offer + answer" vertex="1">
          <mxGeometry height="24" width="500" x="70" y="700" as="geometry" />
        </mxCell>
        <mxCell id="ch30" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="+ &amp;nbsp;robot_agent/topics.py: two topic helpers" vertex="1">
          <mxGeometry height="24" width="500" x="70" y="730" as="geometry" />
        </mxCell>
        <mxCell id="ch31" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="+ &amp;nbsp;backend app/webrtc/relay.py — new" vertex="1">
