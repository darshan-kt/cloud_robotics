        <mxCell id="c36" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Dashboard + panels&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;Telemetry, health and the&lt;br&gt;LiDAR canvas (500ms poll)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1406" y="740" width="240" height="128" as="geometry" />
