        <mxCell id="band22" value="GUARDS  —  every command passes these before it reaches the broker" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;1 &amp;nbsp;Rate limit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Redis fixed window per&lt;br&gt;(operator, robot_id)&lt;br&gt;&lt;b&gt;40 cmd/s&lt;/b&gt; — double the&lt;br&gt;frontend&#39;s own 20/s throttle,&lt;br&gt;so it only catches a flood.&lt;br&gt;&lt;br&gt;&lt;b style=&#39;color:#C62828&#39;&gt;stop is exempt.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="452" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;2 &amp;nbsp;Session ownership&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Redis SET key NX EX &amp;#8212;&lt;br&gt;an atomic &#39;grant only if&lt;br&gt;nobody holds it&#39;.&lt;br&gt;require_holder() + renew().&lt;br&gt;TTL 30s auto-releases a&lt;br&gt;crashed operator.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="404" y="452" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;3 &amp;nbsp;Audit log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Postgres audit_log:&lt;br&gt;entry_hash = sha256(&lt;br&gt;&amp;nbsp;&amp;nbsp;prev_hash + row)&lt;br&gt;Hash-chained, so a later&lt;br&gt;edit is detectable.&lt;br&gt;Best-effort — never blocks.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="728" y="452" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;4 &amp;nbsp;Then, and only then&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;MQTTService.publish_command()&lt;br&gt;&amp;#8212; the one thing the backend&lt;br&gt;is trusted to originate.&lt;br&gt;The ACL forbids it from&lt;br&gt;publishing telemetry, health,&lt;br&gt;status or an SDP answer.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1052" y="452" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="nt27" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Why stop bypasses everything.&lt;/b&gt; A misbehaving robot, or an operator who walked away mid-session, must be stoppable by &lt;i&gt;any&lt;/i&gt; authenticated operator, instantly. Requiring &#39;acquire the lock first&#39; before an emergency stop would be exactly backwards.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1376" y="452" width="268" height="165" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
