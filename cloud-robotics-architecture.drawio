          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg04" name="03 · Video Path (WebRTC)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr1" value="" style="rounded=1;arcSize=6;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=0;html=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1640" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bar2" value="" style="rounded=0;fillColor=#2E7D32;strokeColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="10" height="92" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#2E7D32&quot;&gt;&lt;b&gt;RUNTIME  ·  PATH 2&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;Video — the media plane&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;The backend relays SDP &lt;i&gt;text&lt;/i&gt;, twice. It never sees a single video byte.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="78" y="30" width="1460" height="92" as="geometry" />
        </mxCell>
        <mxCell id="band4" value="SIGNALLING  —  SDP only, MQTT-mediated, non-trickle ICE" style="rounded=1;arcSize=3;fillColor=#F5FAFF;strokeColor=#1565C0;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#1565C0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="980" height="600" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="1" style="ellipse;fillColor=#5E35B1;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="200" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;new RTCPeerConnection(recvonly)&lt;br&gt;createOffer() · wait for full&lt;br&gt;local ICE gathering&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="2" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="544" y="200" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;POST /robots/{id}/webrtc/offer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Bearer JWT. &lt;b&gt;Does not&lt;/b&gt; require&lt;br&gt;holding the control session —&lt;br&gt;watching and driving are independent.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="550" y="210" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="3" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="338" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;webrtc/relay.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Generates a &lt;b&gt;request_id&lt;/b&gt; (uuid),&lt;br&gt;parks an asyncio.Future,&lt;br&gt;20-second timeout&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="348" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="4" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="544" y="338" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;MQTT robots/{id}/camera/offer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;QoS 1 · backend&amp;#8594;robot&lt;br&gt;{request_id, sdp}&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="550" y="348" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b13" value="5" style="ellipse;fillColor=#E65100;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="476" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;agent._on_camera_offer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Spins a &lt;b&gt;dedicated thread&lt;/b&gt; per offer —&lt;br&gt;handle_offer() blocks ~10s on ICE&lt;br&gt;gathering and would stall every&lt;br&gt;other inbound message&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="486" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b15" value="6" style="ellipse;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="544" y="476" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;_prepare_fresh_webrtcbin()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Tears down the previous webrtcbin,&lt;br&gt;links a brand-new one behind a&lt;br&gt;BLOCK_DOWNSTREAM pad probe&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="550" y="486" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b17" value="7" style="ellipse;fillColor=#1565C0;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="614" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;MQTT robots/{id}/camera/answer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;QoS 1 · robot&amp;#8594;backend&lt;br&gt;request_id echoes the offer&#39;s —&lt;br&gt;MQTT 3.1.1 has no native correlation&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="624" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="b19" value="8" style="ellipse;fillColor=#5E35B1;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="544" y="614" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;HTTP 200 {sdp}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Relay resolves the matching Future.&lt;br&gt;Browser setRemoteDescription(answer)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="550" y="624" width="450" height="118" as="geometry" />
        </mxCell>
        <mxCell id="band21" value="MEDIA  —  direct, peer to peer, backend not involved" style="rounded=1;arcSize=3;fillColor=#F4FBF5;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2E7D32;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1052" y="160" width="628" height="600" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;ICE connectivity checks &amp;#8594; coturn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Chrome only ever advertises mDNS-obfuscated host candidates (&lt;i&gt;ea9787…​.local&lt;/i&gt;). The robot&#39;s libnice stack cannot resolve them — no mDNS resolver in a minimal container, no multicast over a Docker bridge.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1082" y="212" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;A TURN relay candidate is never obfuscated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;It is the TURN server&#39;s own address, so the robot gets something real to connect back to. Local coturn today, coturn on EC2 later — same shape.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1082" y="348" width="570" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;DTLS-SRTP · H264 RTP · robot &amp;#8594; browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;640×480, readyState 4, currentTime advancing. Proven by the robot&#39;s own &lt;code&gt;rtp_packets_sent&lt;/code&gt; climbing — not by the browser&#39;s opinion of itself.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1082" y="470" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=3;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=3;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nt27" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Non-trickle, deliberately.&lt;/b&gt; The robot waits for full ICE gathering before answering, so one request/response is enough and no second channel for ongoing candidates is needed. That is also why REST (not a WebSocket) is the architecturally correct fit for the browser-facing side: an offer/answer exchange is one-shot, not a stream.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1082" y="606" width="570" height="132" as="geometry" />
        </mxCell>
        <mxCell id="band28" value="THE PIPELINE ON THE ROBOT  —  one GStreamer graph, one GLib thread" style="rounded=1;arcSize=3;fillColor=#FFF9F2;strokeColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#E65100;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p29" value="&lt;b&gt;appsrc&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;camera frames&lt;br&gt;pushed in&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p30" value="&lt;b&gt;videoconvert&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;to I420&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="298" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p31" value="&lt;b&gt;x264enc&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;H264 baseline&lt;br&gt;zerolatency&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="526" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p32" value="&lt;b&gt;rtph264pay&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;RTP packetise&lt;br&gt;pt = offer&#39;s own&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="754" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p33" value="&lt;b&gt;capsfilter&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;stream-format=&lt;br&gt;byte-stream&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="982" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p34" value="&lt;b&gt;fakesink&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;until an offer&lt;br&gt;arrives&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1210" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p35" value="&lt;b&gt;webrtcbin&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;fresh, per offer&lt;br&gt;DTLS-SRTP out&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1438" y="848" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p29" target="p30">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p30" target="p31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p31" target="p32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p32" target="p33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33" target="p34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#546E7A;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p34" target="p35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nt42" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;The bug that took five debugging passes.&lt;/b&gt; The capsfilter never declared &lt;code&gt;stream-format&lt;/code&gt;. Left as an unconstrained wildcard, &lt;code&gt;create-answer&lt;/code&gt; silently failed to bind a transceiver at all — producing an inert &lt;code&gt;a=inactive&lt;/code&gt; answer that looked like four other problems from the outside. Setting the field explicitly fixed it on both GStreamer 1.20.3 and 1.24.2.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="940" width="780" height="116" as="geometry" />
        </mxCell>
        <mxCell id="nt43" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;And the race it left behind.&lt;/b&gt; &lt;code&gt;appsrc&lt;/code&gt; streams on its own GStreamer thread, independent of the GLib loop that swaps in a fresh webrtcbin — so a frame could be mid-flight through the pad being unlinked. Fixed with a &lt;code&gt;BLOCK_DOWNSTREAM&lt;/code&gt; pad probe. Stress-tested at 16 rapid reconnects: 14 failures before, 0 after.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="940" width="780" height="116" as="geometry" />
        </mxCell>
        <mxCell id="l44" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/06-video-streaming.md · docs/08-webrtc-signalling.md · robot_agent/video_streamer.py&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1074" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg05" name="04 · Auth &amp; Audit">
    <mxGraphModel dx="2111" dy="1131" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr1" parent="1" style="rounded=1;arcSize=6;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=0;html=1;shadow=0;" value="" vertex="1">
          <mxGeometry height="92" width="1640" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="bar2" parent="1" style="rounded=0;fillColor=#C62828;strokeColor=none;html=1;" value="" vertex="1">
          <mxGeometry height="92" width="10" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#C62828&quot;&gt;&lt;b&gt;RUNTIME  ·  PATH 3&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;Auth and audit — the security plane&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;Cross-cutting, not robot-specific. Every login, socket and command goes through this machinery. Added post-Milestone-11.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="1460" x="78" y="30" as="geometry" />
        </mxCell>
        <mxCell id="band4" parent="1" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" value="LOGIN  —  and what stops a brute force" vertex="1">
          <mxGeometry height="380" width="810" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;POST /auth/login&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;{username, password}&lt;br&gt;One shared operator credential&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="340" x="70" y="210" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;seconds_locked_out(client_ip)?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Redis counter per IP&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92" width="350" x="470" y="210" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;5 failures in 5 min &amp;#8594; &lt;b&gt;429&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Retry-After. A &lt;i&gt;correct&lt;/i&gt; password during lockout still gets 429 — the lockout is on the endpoint.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="350" x="470" y="326" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;hmac.compare_digest()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Constant time. A naive == leaks how many leading characters matched.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="340" x="70" y="326" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;200 &amp;nbsp;{ access_token, expires_in }&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;JWT carries a random &lt;b&gt;jti&lt;/b&gt;. Default lifetime dropped 3600s &amp;#8594; &lt;b&gt;1800s&lt;/b&gt;. Login attempt recorded in audit_log either way.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="750" x="70" y="438" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="c7" value="too many">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" target="c8" value="allowed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" target="c9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="band14" parent="1" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" value="WEBSOCKETS  —  why a ticket, not the JWT" vertex="1">
          <mxGeometry height="380" width="798" x="882" y="160" as="geometry" />
        </mxCell>
        <mxCell id="nt15" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;Browsers cannot set custom headers on a WebSocket handshake, so &lt;i&gt;something&lt;/i&gt; has to travel in the URL. A long-lived JWT there ends up in access logs, proxy logs and browser history. A 15-second single-use ticket is worthless a moment later.&lt;/div&gt;" vertex="1">
          <mxGeometry height="96" width="740" x="910" y="208" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;POST /auth/ws-ticket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Bearer JWT &amp;#8594; secrets.token_urlsafe(32)&lt;br&gt;Redis SET ws_ticket:{t} EX 15&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="350" x="910" y="320" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;WS /ws/status  ·  /ws/teleop/{id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;?ticket=… &amp;#8594; Redis &lt;b&gt;GETDEL&lt;/b&gt;&lt;br&gt;Atomic, therefore single-use&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="350" x="1300" y="320" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Verified, not assumed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A real Python &lt;code&gt;websockets&lt;/code&gt; client reusing the same ticket twice is rejected with &lt;b&gt;HTTP 403&lt;/b&gt; on the second attempt. The frontend hooks fetch a fresh ticket before every connection — including every reconnect.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="740" x="910" y="428" as="geometry" />
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="band20" parent="1" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" value="REVOCATION  —  making a stateless token cancellable" vertex="1">
          <mxGeometry height="300" width="810" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;POST /auth/logout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Decodes the presented token, stores &lt;code&gt;revoked_jti:{jti}&lt;/code&gt; in Redis&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="96" width="350" x="70" y="618" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;TTL = the token&#39;s own remaining life&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;So the blacklist entry can never outlive the token it revokes — self-cleaning, never grows unbounded&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="96" width="350" x="470" y="618" as="geometry" />
        </mxCell>
        <mxCell id="c23" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;get_current_operator() checks it on &lt;i&gt;every&lt;/i&gt; request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Reusing a logged-out token &amp;#8594; &lt;b&gt;401 Token has been revoked&lt;/b&gt;. A JWT is stateless by design; nothing can invalidate one before its own &lt;code&gt;exp&lt;/code&gt; without some server-side state — this is that state, kept minimal.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="750" x="70" y="742" as="geometry" />
        </mxCell>
        <mxCell id="e24" edge="1" parent="1" source="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="c22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="band25" parent="1" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" value="AUDIT  —  tamper-evident, not just durable" vertex="1">
