        </mxCell>
        <mxCell id="ch32" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="+ &amp;nbsp;backend app/api/webrtc.py — new" vertex="1">
          <mxGeometry height="24" width="500" x="70" y="790" as="geometry" />
        </mxCell>
        <mxCell id="ch33" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="+ &amp;nbsp;mqtt parse_topic() handles multi-segment suffixes" vertex="1">
          <mxGeometry height="24" width="500" x="70" y="820" as="geometry" />
        </mxCell>
        <mxCell id="ch34" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;fontSize=11;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="+ &amp;nbsp;metrics: webrtc_offers_handled / _failed" vertex="1">
          <mxGeometry height="24" width="500" x="70" y="850" as="geometry" />
        </mxCell>
        <mxCell id="ch35" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="&amp;#8722; &amp;nbsp;dev_signalling_server.py" vertex="1">
          <mxGeometry height="24" width="230" x="590" y="700" as="geometry" />
        </mxCell>
        <mxCell id="ch36" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="&amp;#8722; &amp;nbsp;its wiring in main.py" vertex="1">
          <mxGeometry height="24" width="230" x="590" y="730" as="geometry" />
        </mxCell>
        <mxCell id="ch37" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="&amp;#8722; &amp;nbsp;dev_signalling_port config field" vertex="1">
          <mxGeometry height="24" width="230" x="590" y="760" as="geometry" />
        </mxCell>
        <mxCell id="ch38" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="&amp;#8722; &amp;nbsp;DEV_SIGNALLING_PORT env var" vertex="1">
          <mxGeometry height="24" width="230" x="590" y="790" as="geometry" />
        </mxCell>
        <mxCell id="ch39" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=10;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="&amp;#8722; &amp;nbsp;the :8081 port mapping and EXPOSE" vertex="1">
          <mxGeometry height="24" width="230" x="590" y="820" as="geometry" />
        </mxCell>
        <mxCell id="nt40" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Verified against a real Chrome browser negotiating entirely through the new path&lt;/b&gt; — no hosted test page, no dev server (it no longer exists). It had to be a real &lt;code&gt;http://localhost&lt;/code&gt; origin, because Chrome&#39;s Private Network Access policy blocks an opaque-origin page from reaching localhost at all — itself a faithful preview of what the real frontend would face.&lt;br&gt;&lt;br&gt;&lt;code&gt;iceConnectionState: connected&lt;/code&gt; · &lt;code&gt;videoWidth 640 × 480&lt;/code&gt; · &lt;code&gt;readyState 4&lt;/code&gt; · &lt;code&gt;currentTime&lt;/code&gt; advancing 0.788s &amp;#8594; 3.807s over a real 3-second wait · &lt;code&gt;webrtc_offers_handled: 1&lt;/code&gt; and &lt;code&gt;rtp_packets_sent&lt;/code&gt; climbing continuously against the live peer.&lt;br&gt;&lt;br&gt;&lt;b&gt;44/44 backend and 32/32 robot tests&lt;/b&gt; — including four new ACL tests proving the offer/answer split is enforced by the broker, not by convention.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="798" x="882" y="650" as="geometry" />
        </mxCell>
        <mxCell id="l41" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/08-webrtc-signalling.md · VideoStreamer.handle_offer() itself did not change — only what calls it did&lt;/div&gt;" vertex="1">
          <mxGeometry height="24" width="1640" x="40" y="1034" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
