        <mxCell id="p16" value="api/" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l17" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;Thin REST adapters. Extract operator, call FleetManager, map exceptions.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="448" width="490" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p18" value="ws/" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="486" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l19" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;The same operations again, over WebSocket.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="494" width="490" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p20" value="webrtc/" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="532" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l21" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;The signalling relay (Milestone 8).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="540" width="490" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p22" value="audit/" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="578" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l23" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;Hash-chained record of everything (post-M11).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="586" width="490" height="32" as="geometry" />
        </mxCell>
        <mxCell id="band25" value="POSTGRES vs REDIS  —  precisely" style="rounded=1;arcSize=3;fillColor=#F4FBF5;strokeColor=#2E7D32;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#2E7D32;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="768" y="160" width="460" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Postgres holds &lt;b&gt;identity&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Data that must survive a restart of anything else.&lt;br&gt;&lt;br&gt;· &lt;code&gt;robots&lt;/code&gt; — which robot IDs exist&lt;br&gt;· &lt;code&gt;control_sessions&lt;/code&gt; — append-only: who drove what, when, for how long&lt;br&gt;· &lt;code&gt;audit_log&lt;/code&gt; (post-M11)&lt;br&gt;&lt;br&gt;If Redis were flushed right now, none of this should vanish. A robot does not stop existing because a cache warmed up empty.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="208" width="404" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Redis holds &lt;b&gt;live state&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Either expensive to re-derive, or needing a primitive Postgres does not have.&lt;br&gt;&lt;br&gt;· online/offline status, latest telemetry / health / lidar — written on &lt;i&gt;every&lt;/i&gt; MQTT message, read on every dashboard poll&lt;br&gt;· the control lock: &lt;code&gt;SET key value NX EX ttl&lt;/code&gt; — genuinely the right primitive for &#39;grant only if nobody holds it, and auto-release if the holder disappears&#39;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="796" y="414" width="404" height="200" as="geometry" />
        </mxCell>
        <mxCell id="band28" value="TWO TRANSPORTS, ONE RULE SET" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1256" y="160" width="424" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;POST /robots/{id}/control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;REST · one discrete command&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="212" width="368" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;WS /ws/teleop/{robot_id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A continuous interactive stream&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="306" width="368" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;fleet/manager.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;send_command()&lt;/code&gt; — where the session check actually lives.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="414" width="368" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#C62828;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#C62828;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nt34" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;If the ownership check lived in the route handler it would be written twice, and could drift. Because it lives in one place, both transports are provably consistent &lt;b&gt;by construction&lt;/b&gt;.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1284" y="530" width="368" height="92" as="geometry" />
        </mxCell>
        <mxCell id="band35" value="THE SESSION LIFECYCLE  —  mirroring the robot&#39;s own Will" style="rounded=1;arcSize=3;fillColor=#F5FAFF;strokeColor=#1565C0;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#1565C0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="810" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Clean disconnect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The &lt;code&gt;finally&lt;/code&gt; block releases the lock immediately — operator navigates away, closes the tab tidily.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="706" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Unclean disconnect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;No close frame ever arrives, so &lt;code&gt;finally&lt;/code&gt; never runs. The Redis TTL (30s) expires on its own.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="452" y="706" width="368" height="92" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Same idea as MQTT&#39;s Last Will, reimplemented one layer up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;There is no broker underneath a WebSocket to do it automatically — so the session lock does it itself, exactly the way &lt;code&gt;docs/03-mqtt-layer.md&lt;/code&gt; described for the robot&#39;s own online/offline status.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="812" width="750" height="76" as="geometry" />
        </mxCell>
        <mxCell id="nt39" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;A real bug this milestone&#39;s testing found — in a Milestone 3 test.&lt;/b&gt; &lt;code&gt;test_backend_cannot_publish_robot_telemetry&lt;/code&gt; started failing, apparently asserting an ACL bypass. Inspecting the actual received payloads rather than trusting the assertion showed they were the &lt;i&gt;real robot&#39;s own legitimate telemetry&lt;/i&gt; — the boundary was never breached. The test&#39;s original &lt;code&gt;assert not received&lt;/code&gt; quietly assumed zero other traffic on that topic, which was true in Milestone 3 and stopped being safe the moment a continuously-publishing robot became normal. Fixed to assert the &lt;i&gt;specific spoofed payload&lt;/i&gt; never arrives — which is what it always meant to prove.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="660" width="798" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nt40" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Why &lt;code&gt;stop&lt;/code&gt; bypasses the session check, and nothing else does.&lt;/b&gt; A robot that is misbehaving, or whose operator has walked away mid-session, must be stoppable by &lt;i&gt;any&lt;/i&gt; authenticated operator, immediately. Requiring &#39;acquire the lock first&#39; before an emergency stop would be exactly backwards for the one command where speed and universal access matter most. &lt;code&gt;test_stop_works_even_when_someone_else_holds_the_session&lt;/code&gt; keeps it true.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="1640" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l41" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/07-cloud-backend.md · Traced end to end for real: curl &amp;#8594; FastAPI &amp;#8594; MQTT &amp;#8594; agent logs &#39;Dispatched forward &amp;#8594; linear=0.20&#39; &amp;#8594; the simulated wheels turn&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
