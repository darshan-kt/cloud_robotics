        </mxCell>
        <mxCell id="e49" edge="1" parent="1" source="c37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2E7D32;strokeWidth=5;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endSize=8;" target="c14" value="DTLS-SRTP media (H264 RTP)  —  never passes through the backend">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1559" y="772" />
              <mxPoint x="200" y="772" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="nt50" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;The hard rule.&lt;/b&gt; The backend never speaks ROS2. ROS2/DDS wants a flat, low-latency LAN with multicast discovery; MQTT was invented for exactly the opposite. The agent is the only thing allowed to speak both — on the robot&#39;s side of the boundary.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="470" x="392" y="840" as="geometry" />
        </mxCell>
        <mxCell id="nt51" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Two protocols on purpose.&lt;/b&gt; MQTT carries small, reliable, discrete messages. WebRTC carries 30fps H264 with congestion control and NAT traversal. Using the right one for each is the difference between an instant robot and a laggy one.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="470" x="886" y="848" as="geometry" />
        </mxCell>
