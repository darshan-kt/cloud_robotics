        <mxCell id="c10" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#16202B;&quot;&gt;x264enc&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;H264 baseline&lt;br&gt;never MJPEG, never RTSP&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
