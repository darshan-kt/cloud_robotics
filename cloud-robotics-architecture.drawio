        <mxCell id="c35" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;WS /ws/status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;Full fleet snapshot&lt;br&gt;pushed every 2 seconds&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
