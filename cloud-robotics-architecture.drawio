          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="band19" value="THE CAMERA-SOURCE PIVOT" style="rounded=1;arcSize=3;fillColor=#FFF9F2;strokeColor=#E65100;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#E65100;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="810" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Was: Gazebo&#39;s simulated camera&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Needed Xvfb and a virtual display just to render at all. Robot container steady state: &lt;b&gt;~3 GiB RAM · ~354% CPU&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="448" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Now: a real webcam node&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;webcam_driver.py&lt;/code&gt; publishes onto the &lt;i&gt;same&lt;/i&gt; /camera/image_raw topic. Steady state: &lt;b&gt;~620 MiB · ~150% CPU&lt;/b&gt; — roughly 80% less.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="456" y="448" width="366" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Why it had to change&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Gazebo + ROS2 + a live x264 encode + Chrome under Playwright, all at once, &lt;b&gt;crash-looped the project&#39;s own 7.6 GiB dev machine&lt;/b&gt; — confirmed via &lt;code&gt;last -x&lt;/code&gt; (sub-15-minute boots, one session logged as a crash). The pivot bought back enough headroom to make a real-browser test survivable. &lt;code&gt;docker-compose.yml&lt;/code&gt; now also caps the robot service at 4 CPUs / 3.5G.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="578" width="752" height="106" as="geometry" />
        </mxCell>
        <mxCell id="band23" value="THREE WAYS TO FEED IT" style="rounded=1;arcSize=3;fillColor=#FAFBFC;strokeColor=#7A8896;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#7A8896;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="882" y="400" width="798" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;make up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;No camera source. The honest default — a real deployment with no camera should fail loudly, not silently fake it.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="910" y="448" width="742" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;make up-test-pattern&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A synthetic animated pattern. Explicit opt-in, clearly labelled. How CI and a camera-less laptop see the video path work.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="910" y="530" width="742" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;make up-camera&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Your actual physical webcam becomes the robot&#39;s camera, streamed live over WebRTC.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="910" y="612" width="742" height="70" as="geometry" />
        </mxCell>
        <mxCell id="band27" value="FIVE DEBUGGING PASSES" style="rounded=1;arcSize=3;fillColor=#FFF7F7;strokeColor=#C62828;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#C62828;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b28" value="1" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="768" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;profile-level-id&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;A real byte mismatch, precisely measured.&lt;br&gt;&lt;b&gt;Not the blocker.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="784" width="292" height="116" as="geometry" />
        </mxCell>
        <mxCell id="b30" value="2" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="386" y="768" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;RTP payload type&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Real, and still needed — RFC 3264 requires answering at the offer&#39;s numbering.&lt;br&gt;&lt;b&gt;Not sufficient.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="392" y="784" width="292" height="116" as="geometry" />
        </mxCell>
        <mxCell id="b32" value="3" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="708" y="768" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;a real packet counter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;&lt;code&gt;rtp_packets_sent&lt;/code&gt; via a buffer probe. Proved media was &lt;i&gt;not&lt;/i&gt; flowing.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="714" y="784" width="292" height="116" as="geometry" />
        </mxCell>
        <mxCell id="b34" value="4" style="ellipse;fillColor=#C62828;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1030" y="768" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;the transceiver gap&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;mid, mlineindex and sender.transport all unset. Identified &lt;i&gt;what&lt;/i&gt; was broken.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1036" y="784" width="292" height="116" as="geometry" />
        </mxCell>
        <mxCell id="b36" value="5" style="ellipse;fillColor=#2E7D32;strokeColor=#FFFFFF;strokeWidth=2;html=1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1352" y="768" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;&lt;b&gt;stream-format&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The capsfilter never declared it. Left as a wildcard, create-answer silently bound no transceiver at all.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1358" y="784" width="292" height="116" as="geometry" />
        </mxCell>
        <mxCell id="nt38" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;The fix, and why it needed a structural change too.&lt;/b&gt; Adding &lt;code&gt;stream-format=(string)byte-stream&lt;/code&gt; made &lt;code&gt;create-answer&lt;/code&gt; succeed &lt;i&gt;natively&lt;/i&gt; on both GStreamer 1.20.3 and 1.24.2 — &lt;code&gt;avc&lt;/code&gt; worked equally well, so it was never about the value, only about the field being explicit rather than ambiguous. But a caps change on an &lt;i&gt;already-negotiated&lt;/i&gt; pad does not reliably reach webrtcbin&#39;s internal state: the encode chain now terminates in a throwaway &lt;code&gt;fakesink&lt;/code&gt; and links into a &lt;b&gt;freshly-requested&lt;/b&gt; webrtcbin pad only when an offer arrives, with correct caps from the very first link.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="946" width="1640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l39" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/06-video-streaming.md — the longest debugging story in the project, documented in full rather than smoothed over&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
