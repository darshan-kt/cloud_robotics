        <mxCell id="c33" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;MQTT topics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;telemetry Q0 · health Q1&lt;br&gt;status Q1 &lt;b&gt;retained&lt;/b&gt; · lidar Q0&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="602" y="740" width="240" height="128" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;&quot;&gt;RobotRegistry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;record_* &amp;#8594; Redis (live)&lt;br&gt;_ensure_registered &amp;#8594; Postgres&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
