        <mxCell id="p12" value="fleet/" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="348" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l13" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;The one place that composes registry + sessions + MQTT.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="226" y="356" width="490" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p14" value="auth/" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="394" width="140" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l15" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;username/password &amp;#8594; JWT, and JWT &amp;#8594; operator identity.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
