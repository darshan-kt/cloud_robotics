        <mxCell id="c33" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:13px;color:#16202B;font-family:Consolas,Menlo,monospace;&quot;&gt;docs/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Cloud-side implementation notes too low-level for docs/&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="68" width="600" x="910" y="704" as="geometry" />
        </mxCell>
        <mxCell id="ch34" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90CAF9;fontSize=10;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" value="filled in as needed" vertex="1">
          <mxGeometry height="24" width="120" x="1530" y="726" as="geometry" />
        </mxCell>
        <mxCell id="nt35" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Why two top-level containers, not one?&lt;/b&gt; Because they run on different hardware in production, full stop. The robot half lives on a Jetson bolted to a Turtlebot3; the cloud half lives in AWS. Build them as one container with in-process calls and separating them later means rewriting the interface, not changing a config value.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="800" x="40" y="830" as="geometry" />
        </mxCell>
        <mxCell id="nt36" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF9F2;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Why &lt;code&gt;robot_agent/&lt;/code&gt; and &lt;code&gt;ros_ws/&lt;/code&gt; are separate folders.&lt;/b&gt; So the agent can define &lt;code&gt;ROSAdapter&lt;/code&gt; as an interface and be fully built, run and unit-tested with zero ROS2 installed. The folder boundary is what makes it enforceable in review: an &lt;code&gt;rclpy&lt;/code&gt; import inside &lt;code&gt;robot_agent/&lt;/code&gt; means something leaked.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="800" x="880" y="830" as="geometry" />
        </mxCell>
        <mxCell id="l37" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/01-repository-structure.md&lt;/div&gt;" vertex="1">
          <mxGeometry height="24" width="1640" x="40" y="1034" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg07" name="M2 · Docker Foundations">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr1" value="" style="rounded=1;arcSize=6;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=0;html=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1640" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bar2" value="" style="rounded=0;fillColor=#1565C0;strokeColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="10" height="92" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#1565C0&quot;&gt;&lt;b&gt;MILESTONE 2&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;Docker foundations&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;Six containers that boot together with one command. No real behaviour yet — but every arrow in the architecture diagram is now provably wired.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="78" y="30" width="1460" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bg4" value="2" style="ellipse;fillColor=#1565C0;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=22;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="46" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="docker compose up   ·   network: cloud-robotics-net" style="rounded=1;arcSize=3;fillColor=#F5FAFF;strokeColor=#1565C0;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#1565C0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1080" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:15px;color:#16202B;&quot;&gt;mosquitto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;eclipse-mosquitto:2&lt;br&gt;&lt;br&gt;1883 &amp;#8594; host&lt;br&gt;healthcheck &amp;#10003;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="212" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:15px;color:#16202B;&quot;&gt;backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;FastAPI + uvicorn&lt;br&gt;&lt;br&gt;8000 &amp;#8594; host&lt;br&gt;healthcheck &amp;#10003;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="416" y="212" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:15px;color:#16202B;&quot;&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;Vite dev / nginx prod&lt;br&gt;&lt;br&gt;3000 &amp;#8594; host&lt;br&gt;healthcheck &amp;#10003;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="758" y="212" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:15px;color:#16202B;&quot;&gt;redis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;redis:7-alpine&lt;br&gt;&lt;br&gt;&lt;b&gt;internal only&lt;/b&gt;&lt;br&gt;healthcheck &amp;#10003;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="380" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:15px;color:#16202B;&quot;&gt;postgres&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;postgres:16-alpine&lt;br&gt;&lt;br&gt;&lt;b&gt;internal only&lt;/b&gt;&lt;br&gt;healthcheck &amp;#10003;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="416" y="380" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:15px;color:#16202B;&quot;&gt;robot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A6B7B&quot;&gt;ros:humble-ros-base&lt;br&gt;&lt;br&gt;8080 health&lt;br&gt;healthcheck added in M4&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="758" y="380" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="band12" value="The rules this milestone set" style="rounded=1;arcSize=3;fillColor=#FAFBFC;strokeColor=#7A8896;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#7A8896;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="160" width="520" height="400" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;depends_on: service_healthy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;The backend will not start until Mosquitto, Redis and Postgres report healthy. A failure surfaces as &#39;mosquitto never became healthy&#39;, not a confusing connection-refused three layers away.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="212" width="464" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;Redis and Postgres publish no host port&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Only what something &lt;i&gt;outside&lt;/i&gt; Docker must reach gets published. This is the local stand-in for a VPC public/private subnet split — the same boundary, so there is none to &lt;i&gt;add&lt;/i&gt; later.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="328" width="464" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:14px;color:#16202B;&quot;&gt;A named bridge network&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5A6B7B&quot;&gt;Every service resolves every other by Compose service name. Exactly the mental model for ECS Service Connect — code never hardcodes an IP.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1188" y="444" width="464" height="96" as="geometry" />
        </mxCell>
        <mxCell id="band16" value="The frontend&#39;s runtime config trick   —   why the API URL is not baked in" style="rounded=1;arcSize=3;fillColor=#F8F5FF;strokeColor=#5E35B1;strokeWidth=2;dashed=1;dashPattern=8 5;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#5E35B1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p17" value="&lt;b&gt;vite build&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;Normally bakes&lt;br&gt;VITE_API_BASE_URL&lt;br&gt;into the bundle&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="646" width="292" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p18" value="&lt;b&gt;config.template.json&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;{&quot;apiBaseUrl&quot;:&lt;br&gt;&quot;${API_BASE_URL}&quot;}&lt;br&gt;ships beside the app&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="396" y="646" width="292" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p19" value="&lt;b&gt;container start&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;nginx runs every *.sh&lt;br&gt;in /docker-entrypoint.d/&lt;br&gt;&amp;#8594; envsubst&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="718" y="646" width="292" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p20" value="&lt;b&gt;config.json&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;The React app fetches&lt;br&gt;it once on load&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="646" width="292" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p21" value="&lt;b&gt;Same compiled JS&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;color:#5A6B7B&#39;&gt;works against localhost&lt;br&gt;&lt;b&gt;or&lt;/b&gt; an AWS domain —&lt;br&gt;one env var changes&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16202B;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1362" y="646" width="292" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5E35B1;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17" target="p18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5E35B1;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18" target="p19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5E35B1;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19" target="p20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5E35B1;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;endSize=6;fontSize=10;fontColor=#5E35B1;labelBackgroundColor=#FFFFFF;spacingTop=-2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p20" target="p21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l26" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#5A6B7B&quot;&gt;One detail worth internalising: &lt;code&gt;API_BASE_URL&lt;/code&gt; must be an address the &lt;b&gt;browser&lt;/b&gt; can reach. &lt;code&gt;http://backend:8000&lt;/code&gt; resolves fine inside the Docker network — your browser runs on the host and has no idea what &lt;code&gt;backend&lt;/code&gt; means. That is exactly the distinction between an internal service endpoint and a public ALB URL in AWS.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="772" width="1580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nt27" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Why the robot image is already &lt;code&gt;ros:humble-ros-base&lt;/code&gt;.&lt;/b&gt; Nothing here uses ROS2 — the placeholder is plain Python over MQTT. But starting on the real target means Milestone 5 only ever &lt;i&gt;adds&lt;/i&gt; layers, and never has to retest a base this milestone already validated.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="866" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nt28" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:11px;color:#16202B&quot;&gt;&lt;b&gt;Verified, not assumed.&lt;/b&gt; &lt;code&gt;docker exec …&amp;nbsp;mosquitto_sub -t &#39;robots/+/heartbeat&#39;&lt;/code&gt; — subscribed from &lt;i&gt;inside the broker itself&lt;/i&gt;, independent of what the robot&#39;s own logs claimed. The prod nginx target was also built and run standalone to prove the AWS-mirroring path is not theoretical.&lt;/div&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="866" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l29" value="&lt;div style=&quot;text-align:left;line-height:1.5;font-size:10px;color:#90A4AE&quot;&gt;docs/02-docker-foundations.md&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1640" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg08" name="M3 · MQTT Layer &amp; ACLs">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr1" value="" style="rounded=1;arcSize=6;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=0;html=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1640" height="92" as="geometry" />
        </mxCell>
        <mxCell id="bar2" value="" style="rounded=0;fillColor=#1565C0;strokeColor=none;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="10" height="92" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11px;letter-spacing:2px;color:#1565C0&quot;&gt;&lt;b&gt;MILESTONE 3&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#16202B&quot;&gt;&lt;b&gt;The MQTT layer&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6B7B&quot;&gt;&lt;code&gt;allow_anonymous true&lt;/code&gt; is gone. Every client authenticates, and an ACL — not a document — enforces the isolation boundary.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="78" y="30" width="1460" height="92" as="geometry" />
